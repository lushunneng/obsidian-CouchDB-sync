COMPOSE_PROJECT_NAME=obsidian-livesync
LIVESYNC_DOMAIN=sync.example.com
COUCHDB_DATABASE=obsidiannotes
COUCHDB_IMAGE=couchdb:3.4.3
COUCHDB_DATA_DIR=/opt/obsidian-livesync/data/couchdb
BACKUP_DIR=/opt/backup/obsidian-livesync
COUCHDB_ADMIN_USER=replace-with-a-dedicated-admin-user
COUCHDB_ADMIN_PASSWORD=replace-with-a-long-random-password
COUCHDB_SECRET=replace-with-another-long-random-secret
